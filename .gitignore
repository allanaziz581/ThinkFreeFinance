# ── Secrets (NEVER commit) ──
.env
.env.*
*.key
*.pem
secrets*
*credential*

# ── Virtual environments (huge, machine-specific) ──
tf_env/
venv/
venv_qlib/
.venv/
env/

# ── Landing (React/Vite) build tooling ──
# node_modules is never deployed; the COMPILED bundle in webapp/landing-dist/ IS
# committed and served by FastAPI at /. Do not ignore landing-dist.
landing/node_modules/
landing/.vite/

# ── Python caches / build ──
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.ipynb_checkpoints/

# ── ML / experiment tracking ──
mlruns/

# ── Large data & generated artifacts ──
qlib_data/
raw_data/
ta_raw/
news_output/
GPT_Economy/
congress_ticker_clusters/
Economic_Books/

# ── OS / editor ──
.DS_Store
*.swp
.idea/
.vscode/

# ── Large media not needed in repo ──
*.zip

# ── Local Claude config (may contain keys in allowlist) ──
# Ignore everything under .claude EXCEPT the shareable security sub-agent + its
# knowledge base. settings.json / settings.local.json stay ignored.
.claude/*
!.claude/agents/

# Generated documentation intermediate (the PDF in docs/ is committed instead)
docs_build/*.html

# Local-only beta admin seed (contains a password hash) - never commit
webapp/js/auth_seed.js

# Scheduler runtime artifacts (logs + pid)
scheduler/logs/
scheduler/scheduler.pid
